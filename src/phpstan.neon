includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 10
    paths:
        - app/
        - config/
        - database/
        - routes/
        - tests/

    # Le `(?)` marque un chemin OPTIONNEL. Sans lui, PHPStan refuse de démarrer
    # si le répertoire n'existe pas — « Path … is neither a directory, nor a
    # file path, nor a fnmatch pattern ».
    #
    # Constaté au premier run réel de la CI découpée : le job `quality` n'a pas
    # besoin de Node, donc il n'exécute pas `npm ci`, donc `node_modules/`
    # n'existe pas. En local il est toujours présent — le défaut était donc
    # strictement invisible hors CI.
    # PHP_CodeSniffer n'est pas chargé en PSR-4 : il embarque son propre
    # autoloader, donc PHPStan ne trouve pas les sniffs référencés par
    # config/insights.php (LineLengthSniff::class) et les signalait comme
    # « class not found ». Le fichier existe bien — c'est un problème de
    # découverte, pas une dépendance manquante.
    # (Pas de suffixe `(?)` ici : contrairement à `paths` et `excludePaths`,
    # `scanDirectories` ne l'accepte pas et PHPStan échoue à construire son
    # conteneur — « Nette\DI\ServiceCreationException ». Le répertoire est de
    # toute façon garanti par composer.lock.)
    scanFiles:
        - vendor/squizlabs/php_codesniffer/src/Standards/Generic/Sniffs/Files/LineLengthSniff.php

    excludePaths:
        - bootstrap/
        - storage/ (?)
        - vendor/ (?)
        - node_modules/ (?)
        - database/migrations/

    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    checkUninitializedProperties: true
    checkBenevolentUnionTypes: true
    checkExplicitMixedMissingReturn: true
    checkFunctionNameCase: true
    checkInternalClassCaseSensitivity: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkMissingCallableSignature: true
    checkPhpDocMethodSignatures: true
