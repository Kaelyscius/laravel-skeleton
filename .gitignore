# ===========================================
# 🔐 FICHIERS SENSIBLES - SÉCURITÉ CRITIQUE
# ===========================================
# ATTENTION: Ces fichiers contiennent des vraies valeurs (tokens, passwords)

# Tous les fichiers .env et leurs variantes
.env
.env.*
!.env.example

# Fichiers .env spécifiques par environnement (VRAIES VALEURS)
.env.local
.env.development
.env.staging
.env.production

# Sauvegardes .env (peuvent contenir des secrets)
.env.backup*
.env.*.backup*

# Fichiers de configuration sensibles
config/*.key
config/*.pem
config/*.p12
*.key
*.pem
*.p12

# Tokens et clés API — patterns ANCRÉS par extension et par répertoire.
#
# ⚠️ NE PAS réintroduire `*token*`, `*secret*` ou `*password*`.
#
# Ces trois patterns ont été retirés le 2026-07-27. Ils filtraient le NOM des
# fichiers, ce qui a échoué dans les deux sens :
#   - faux positif : ils ont silencieusement exclu src/resources/css/tokens.css,
#     livrable central de la Story 1.8. Build vert en local, fichier absent après
#     un `git clone` — donc cassé pour tout fork-streamer (ADR-0001). Aucune
#     erreur, aucun signal.
#   - faux négatif : ils n'ont JAMAIS empêché un secret d'entrer, puisqu'ils ne
#     regardent pas le contenu. Ils donnaient l'illusion d'une protection.
#   - et le piège était réarmé : la Story 1.10 (Sanctum) apporte
#     create_personal_access_tokens_table et PersonalAccessToken, qui auraient
#     tous deux disparu du dépôt en silence.
#
# La protection par CONTENU est désormais assurée par gitleaks
# (.gitleaksignore + job CI + hook pre-commit), et un test Pest vérifie
# qu'aucun fichier attendu n'a disparu du suivi git.
*.token
*.secret
*.pem.key
.secrets/
secrets/
auth.json

# Certificats SSL (sauf .gitkeep)
docker/apache/conf/ssl/*.crt
docker/apache/conf/ssl/*.key
docker/apache/conf/ssl/*.pem
!docker/apache/conf/ssl/.gitkeep

# Rotations de certificats produites par le script de génération SSL.
# Règle ANCRÉE par chemin : elle remplace l'ancien `*backup*` global, qui
# couvrait bien ces répertoires mais excluait aussi, sans le dire, les ADR et
# les scripts de sauvegarde du projet.
docker/apache/conf/ssl/backup-*/

# ===========================================
# LARAVEL SPÉCIFIQUE
# ===========================================
/src/node_modules
/src/public/build
/src/public/hot
/src/public/storage
/src/storage/*.key
/src/vendor
/src/.env*
!/src/.env.example
/src/.env.backup*
/src/.phpunit.result.cache
/src/Homestead.json
/src/Homestead.yaml
/src/npm-debug.log
/src/yarn-error.log
/src/.fleet
/src/.idea
/src/.vscode
/src/coverage
/src/.php-cs-fixer.cache
/src/.phpactor.json
/src/.php_cs.cache

# ===========================================
# DOCKER & LOGS
# ===========================================
docker/apache/logs/*
!docker/apache/logs/.gitkeep
docker/php/logs/*
!docker/php/logs/.gitkeep
docker/supervisor/logs/*
!docker/supervisor/logs/.gitkeep

# Docker override générés automatiquement
docker-compose.override.yml

# ===========================================
# IDE & DÉVELOPPEMENT
# ===========================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ===========================================
# TESTS & QUALITY
# ===========================================
/coverage
.phpunit.result.cache
.phpunit.cache
/phpunit.xml
/phpstan.cache

# ===========================================
# BUILD & DIST
# ===========================================
/build
/dist
*.log

# ===========================================
# OS SPÉCIFIQUE
# ===========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===========================================
# FICHIERS DE SAUVEGARDE (CRITIQUE)
# ===========================================
*.bak
*.backup*
*.old
*.orig
*.tmp
*.temp

# ⚠️ NE PAS réintroduire `*backup*` (retiré le 2026-07-27).
#
# Même défaut que les anciens `*token*` / `*secret*` : il matchait le NOM de
# n'importe quel fichier, n'importe où. Il a silencieusement exclu
# docs/adr/ADR-0003-backup-local-only-v1.md — un ADR référencé depuis 4 endroits
# (index ADR, glossaire, roundtable-decisions, backlog) mais ABSENT du dépôt.
# Un fork-streamer clonait une documentation aux liens morts.
#
# Les extensions ancrées ci-dessus (*.bak, *.backup*) couvrent le vrai besoin :
# les fichiers de sauvegarde produits par les éditeurs et les scripts.

# ===========================================
# MONITORING & LOGS SENSIBLES
# ===========================================
/monitoring/data/*
!/monitoring/data/.gitkeep

# Logs avec potentiels secrets
*.log
logs/
nightwatch.log
nightwatch.pid

# ===========================================
# RAPPORTS DE SÉCURITÉ
# ===========================================
reports/security/*.json
reports/security/*.html
!reports/security/.gitkeep

# ===========================================
# CONFIGURATION GÉNÉRÉE AUTOMATIQUEMENT
# ===========================================
# Docker compose override (généré par script)
docker-compose.override.yml.backup*

# Configuration installer générée
config/installer.yml.backup*

# ===========================================
# DÉVELOPPEMENT SPÉCIFIQUE
# ===========================================
# Cache des outils
.composer/
node_modules/

# Dépendances Composer — ANCRÉES sur le vrai répertoire.
#
# ⚠️ NE PAS remettre `vendor/` sans ancre : le pattern matchait n'importe quel
# répertoire nommé `vendor` à n'importe quelle profondeur, et excluait donc
# src/resources/views/vendor/ — la convention Laravel pour les vues de packages
# PUBLIÉES, qui doivent être versionnées. Le tableau de bord Pulse personnalisé
# (ADR-0004) était ainsi absent de tout clone.
/vendor/
/src/vendor/

# Configuration locale de développement
.vscode/settings.json
.idea/workspace.xml

# ===========================================
# BMAD - Planification & outils personnels
# ===========================================
# Artefacts de planification party-mode/roundtables (DONNÉES PRIVÉES)
# Contiennent stratégie business, pricing, plans SaaS — JAMAIS dans un repo public
_bmad-output/

# Module BMAD installé localement (configs user-scoped + skills modules)
# Les forkers installent leur propre BMAD via npx bmad-method install si besoin
_bmad/

# ===========================================
# CLAUDE CODE - Skills perso & configs locales
# ===========================================
# Skills Claude Code installés localement (chacun installe les siens)
.claude/skills/

# Settings locaux Claude Code (DOIT être local-only — unstage avec : git rm --cached .claude/settings.local.json)
.claude/settings.local.json