# ===========================================
# 🔐 FICHIERS SENSIBLES - SÉCURITÉ CRITIQUE
# ===========================================
# ATTENTION: Ces fichiers contiennent des vraies valeurs (tokens, passwords)

# Tous les fichiers .env et leurs variantes
.env
.env.*
!.env.example

# Fichiers .env spécifiques par environnement (VRAIES VALEURS)
.env.local
.env.development
.env.staging
.env.production

# Sauvegardes .env (peuvent contenir des secrets)
.env.backup*
.env.*.backup*

# Fichiers de configuration sensibles
config/*.key
config/*.pem
config/*.p12
*.key
*.pem
*.p12

# Tokens et clés API dans tous formats
*token*
*secret*
*password*
.secrets/
secrets/
auth.json

# ⚠️ Les 3 patterns ci-dessus sont des règles SECRETS, mais ils matchent le NOM
# de n'importe quel fichier — y compris du code source parfaitement légitime.
# Chaque faux positif doit être ré-autorisé explicitement ici, sinon le fichier
# disparaît du dépôt SANS erreur : build vert en local, absent après un clone.
# Cas connus à venir : migration Sanctum create_personal_access_tokens_table
# et le modèle PersonalAccessToken (Story 1.10).
!src/resources/css/tokens.css

# Certificats SSL (sauf .gitkeep)
docker/apache/conf/ssl/*.crt
docker/apache/conf/ssl/*.key
docker/apache/conf/ssl/*.pem
!docker/apache/conf/ssl/.gitkeep

# ===========================================
# LARAVEL SPÉCIFIQUE
# ===========================================
/src/node_modules
/src/public/build
/src/public/hot
/src/public/storage
/src/storage/*.key
/src/vendor
/src/.env*
!/src/.env.example
/src/.env.backup*
/src/.phpunit.result.cache
/src/Homestead.json
/src/Homestead.yaml
/src/npm-debug.log
/src/yarn-error.log
/src/.fleet
/src/.idea
/src/.vscode
/src/coverage
/src/.php-cs-fixer.cache
/src/.phpactor.json
/src/.php_cs.cache

# ===========================================
# DOCKER & LOGS
# ===========================================
docker/apache/logs/*
!docker/apache/logs/.gitkeep
docker/php/logs/*
!docker/php/logs/.gitkeep
docker/supervisor/logs/*
!docker/supervisor/logs/.gitkeep

# Docker override générés automatiquement
docker-compose.override.yml

# ===========================================
# IDE & DÉVELOPPEMENT
# ===========================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ===========================================
# TESTS & QUALITY
# ===========================================
/coverage
.phpunit.result.cache
.phpunit.cache
/phpunit.xml
/phpstan.cache

# ===========================================
# BUILD & DIST
# ===========================================
/build
/dist
*.log

# ===========================================
# OS SPÉCIFIQUE
# ===========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===========================================
# FICHIERS DE SAUVEGARDE (CRITIQUE)
# ===========================================
*.bak
*.backup*
*.old
*.orig
*.tmp
*.temp
*backup*

# ===========================================
# MONITORING & LOGS SENSIBLES
# ===========================================
/monitoring/data/*
!/monitoring/data/.gitkeep

# Logs avec potentiels secrets
*.log
logs/
nightwatch.log
nightwatch.pid

# ===========================================
# RAPPORTS DE SÉCURITÉ
# ===========================================
reports/security/*.json
reports/security/*.html
!reports/security/.gitkeep

# ===========================================
# CONFIGURATION GÉNÉRÉE AUTOMATIQUEMENT
# ===========================================
# Docker compose override (généré par script)
docker-compose.override.yml.backup*

# Configuration installer générée
config/installer.yml.backup*

# ===========================================
# DÉVELOPPEMENT SPÉCIFIQUE
# ===========================================
# Cache des outils
.composer/
vendor/
node_modules/

# Configuration locale de développement
.vscode/settings.json
.idea/workspace.xml

# ===========================================
# BMAD - Planification & outils personnels
# ===========================================
# Artefacts de planification party-mode/roundtables (DONNÉES PRIVÉES)
# Contiennent stratégie business, pricing, plans SaaS — JAMAIS dans un repo public
_bmad-output/

# Module BMAD installé localement (configs user-scoped + skills modules)
# Les forkers installent leur propre BMAD via npx bmad-method install si besoin
_bmad/

# ===========================================
# CLAUDE CODE - Skills perso & configs locales
# ===========================================
# Skills Claude Code installés localement (chacun installe les siens)
.claude/skills/

# Settings locaux Claude Code (DOIT être local-only — unstage avec : git rm --cached .claude/settings.local.json)
.claude/settings.local.json