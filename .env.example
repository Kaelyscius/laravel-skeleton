# ===========================================
# 🚀 LARAVEL DOCKER ENVIRONMENT
# ===========================================

# Application
APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:your-app-key-here
APP_DEBUG=true
APP_URL=https://laravel.local
APP_TIMEZONE=UTC

# Docker
COMPOSE_PROJECT_NAME=laravel-app

# ===========================================
# 💾 DATABASE (PostgreSQL)
# ===========================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel_user
DB_PASSWORD=secure_password
# Note : pas de DB_ROOT_PASSWORD avec PostgreSQL.
# Le superuser "postgres" est créé localement par défaut, l'application utilise DB_USERNAME (POSTGRES_USER).

# === Pulse dedicated DB (ADR-0004) — wiring Laravel en Story 3.2 ===
# Conteneur postgres-pulse isolé (jamais exposé à l'hôte). Ces variables sont
# consommées par docker-compose.yml (interpolation ${DB_PULSE_*} depuis CE fichier .env racine).
# Changez DB_PULSE_PASSWORD avant tout déploiement prod (l'installeur le rappelle).
DB_PULSE_HOST=postgres-pulse
DB_PULSE_PORT=5432
DB_PULSE_DATABASE=pulse
DB_PULSE_USERNAME=pulse
DB_PULSE_PASSWORD=pulsesecret

# ===========================================
# 🗄️ REDIS
# ===========================================
REDIS_HOST=redis
REDIS_PASSWORD=redis_secret_password
REDIS_PORT=6379

# ===========================================
# 📧 EMAIL (Développement avec Mailpit)
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@laravel.local"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# ⚙️ GABARITS DE CONFIGURATION (php.ini, vhost) — Story 2.5
# ===========================================
# Ces six variables sont les SEULES manières prévues de régler PHP et Apache
# sans éditer un fichier versionné. Laissées commentées, l'entrypoint repose
# les défauts documentés plus bas.
#
# 🔴 UNE VALEUR CHANGE, ET IL FAUT LE SAVOIR AVANT DE DÉPLOYER : la limite
# mémoire d'UNE REQUÊTE php-fpm passe de 4G (dev) / 2G (prod) à **256M**.
# Avant cette story, `conf.d/composer-optimizations.ini` valait pour TOUS les
# SAPI : chaque requête HTTP disposait de la limite prévue pour composer —
# soit 4G en développement, une division par **16**. C'est délibéré (une
# limite par processus × N enfants php-fpm est ce qui transforme un échec net
# en OOM système), mais ce n'est PAS « rien ne change ». Une application qui
# dépendait sans le savoir de cette marge doit poser `PHP_MEMORY_LIMIT`.
#
# ⚖️ Les autres défauts, eux, reproduisent bien les valeurs effectives
# mesurées le 2026-08-28 : la CLI garde 4G en développement et 2G en
# production, la durée d'exécution garde 300 s, le vhost garde ses trois
# valeurs. Seule la ligne FPM ci-dessus est une rupture.
#
# ⚠️ MESURÉ, PAS RECOPIÉ : avant cette story, `docker/php/conf/php.ini:5`
# annonçait `memory_limit = 256M` alors que la valeur EFFECTIVE valait `4G`
# (`conf.d/composer-optimizations.ini` est lu après `php.ini` et gagne). Le
# fichier qu'un fork-streamer serait allé éditer mentait déjà.
#
# ⚖️ DEUX LIMITES MÉMOIRE, ET C'EST DÉLIBÉRÉ. `memory_limit` est une limite PAR
# PROCESSUS et php-fpm en a N : une valeur unique et haute troquerait un échec
# net et localisé contre un OOM système où le kernel choisit la victime. La
# requête HTTP est donc bornée (`PHP_MEMORY_LIMIT`, via `php_admin_value` du
# pool FPM) et l'outillage en ligne de commande — composer, artisan, PHPStan —
# garde sa marge (`PHP_CLI_MEMORY_LIMIT`).
#
# Limite mémoire d'UNE REQUÊTE php-fpm. Défaut : 256M
#PHP_MEMORY_LIMIT=512M
#
# Limite mémoire de la CLI. Défaut : **dérivé de l'étage de build** — `4G` en
# développement, `2G` en production (`docker/php/Dockerfile`, variable
# `PHP_CLI_MEMORY_LIMIT_DEFAUT`). Poser la variable ici écrase les DEUX.
#
# ⚠️ TROIS CONSOMMATEURS, PAS UN : `composer`, les commandes `artisan` (dont
# l'outillage qualité), et les **workers Horizon** — `supervisor` lance
# `php artisan horizon` dans ce conteneur, en SAPI cli, avec N processus
# enfants. La limite est PAR PROCESSUS : en production, le conteneur est
# plafonné à 1 Go (`docker-compose.prod.yml`), donc une valeur haute ici fait
# tuer les workers par le kernel, sans erreur PHP lisible.
#PHP_CLI_MEMORY_LIMIT=4G
#
# Durée maximale d'exécution, en secondes. Défaut : 300
#PHP_MAX_EXECUTION_TIME=300
#
# Nom d'hôte servi par le vhost Apache. Défaut : laravel.local
# ⚠️ Le certificat TLS, lui, reste attendu sous `laravel.local.crt/.key`
# (`make setup-ssl`) : changer ce nom sans fournir le certificat correspondant
# donne un site servi sous un certificat qui ne le couvre pas.
#APACHE_SERVER_NAME=laravel.local
#
# Alias du vhost. Défaut : www.laravel.local
#APACHE_SERVER_ALIAS=www.laravel.local
#
# Racine servie. Défaut : /var/www/html/public
#APACHE_DOCUMENT_ROOT=/var/www/html/public

# ===========================================
# 🔍 QUEUES (Redis)
# ===========================================
QUEUE_CONNECTION=redis
# ⚠️ CACHE_STORE, PAS CACHE_DRIVER — Laravel 11+ a renommé la clé.
# Mesuré le 2026-08-23 : avec `CACHE_DRIVER=redis`, `config('cache.default')`
# valait `database` (le défaut de `config/cache.php:17`). Redis arrêté, la sonde
# `/health` du cache restait `ok` : elle éprouvait la BASE. Un garde-fou vert
# avec la dépendance qu'il surveille à terre.
CACHE_STORE=redis
SESSION_DRIVER=redis

# ===========================================
# 💾 BACKUP STRATEGY (v1)
# ===========================================
# Couche 1 — backup local VPS quotidien : ACTIVÉ par défaut via scripts/ops/backup-local.sh
# (cf crontab.example pour activer le cron)
#
# Couche 2 — backup offsite (hands-off) : DÉSACTIVÉ par défaut.
# Pour activer (gratuit via Mega/Google Drive/pCloud free tier) :
#   1. Installer rclone : curl https://rclone.org/install.sh | sudo bash
#   2. Configurer : rclone config (créer un remote vers Mega/Drive)
#   3. Mettre BACKUP_OFFSITE_ENABLED=true ci-dessous
#   4. Décommenter la ligne crontab dans crontab.example
#
# Voir scripts/ops/backup-offsite.sh pour la doc complète et la migration
# vers Backblaze B2 payant (~0.50€/mois) en v2+ ou si projet validé.
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_REMOTE=
BACKUP_OFFSITE_PATH=myapp-backups/
BACKUP_OFFSITE_RETENTION_WEEKS=8

# ===========================================
# 📊 MONITORING - Watchtower Notifications
# ===========================================
# Laissez vide pour désactiver les notifications
WATCHTOWER_NOTIFICATION_URL=

# Exemples :
# Discord: discord://token@channel_id
# Slack: slack://hook_url
# Email: smtp://username:password@host:port/?from=from@example.com&to=to@example.com

# ===========================================
# 🛡️ SÉCURITÉ - SNYK CONFIGURATION
# ===========================================

# Token Snyk (optionnel - obtenez-le sur https://app.snyk.io/account)
# Si non configuré, Snyk fonctionnera en mode limité
SNYK_TOKEN=

# Configuration Snyk (avec valeurs par défaut optimales)
SNYK_SEVERITY_THRESHOLD=high
SNYK_FAIL_ON_ISSUES=false
SNYK_MONITOR_ENABLED=true
SNYK_ORG_ID=

# Fichiers à exclure du scan Snyk (patterns séparés par des virgules)
SNYK_EXCLUDE_PATHS=vendor/,node_modules/,tests/,storage/

# Options avancées Snyk
SNYK_INCLUDE_DEV_DEPS=true
SNYK_PRINT_DEPS=false
SNYK_DOCKER_SCAN_ENABLED=false

# Configuration pour différents environnements
SNYK_PROJECT_NAME_PHP="${APP_NAME}-php"
SNYK_PROJECT_NAME_NODE="${APP_NAME}-node"

# ===========================================
# 🔐 SÉCURITÉ
# ===========================================
JWT_SECRET=your-jwt-secret-key
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ===========================================
# 🔧 DÉVELOPPEMENT
# ===========================================
LOG_CHANNEL=stack
LOG_STACK=single,nightwatch,daily
LOG_LEVEL=debug
NIGHTWATCH_TOKEN="${NIGHTWATCH_TOKEN}"
NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0
NIGHTWATCH_COMMAND_SAMPLE_RATE=1.0
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1 #Recommended
TELESCOPE_ENABLED=true
HORIZON_DASHBOARD_ENABLED=true
VITE_APP_NAME="${APP_NAME}"