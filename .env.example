# ===========================================
# 🚀 LARAVEL DOCKER ENVIRONMENT
# ===========================================

# Application
APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:your-app-key-here
APP_DEBUG=true
APP_URL=https://laravel.local
APP_TIMEZONE=UTC

# Docker
COMPOSE_PROJECT_NAME=laravel-app

# ===========================================
# 💾 DATABASE (PostgreSQL)
# ===========================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel_user
DB_PASSWORD=secure_password
# Note : pas de DB_ROOT_PASSWORD avec PostgreSQL.
# Le superuser "postgres" est créé localement par défaut, l'application utilise DB_USERNAME (POSTGRES_USER).

# === Pulse dedicated DB (ADR-0004) — wiring Laravel en Story 3.2 ===
# Conteneur postgres-pulse isolé (jamais exposé à l'hôte). Ces variables sont
# consommées par docker-compose.yml (interpolation ${DB_PULSE_*} depuis CE fichier .env racine).
# Changez DB_PULSE_PASSWORD avant tout déploiement prod (l'installeur le rappelle).
DB_PULSE_HOST=postgres-pulse
DB_PULSE_PORT=5432
DB_PULSE_DATABASE=pulse
DB_PULSE_USERNAME=pulse
DB_PULSE_PASSWORD=pulsesecret

# ===========================================
# 🗄️ REDIS
# ===========================================
REDIS_HOST=redis
REDIS_PASSWORD=redis_secret_password
REDIS_PORT=6379

# ===========================================
# 📧 EMAIL (Développement avec Mailpit)
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@laravel.local"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# 🔍 QUEUES (Redis)
# ===========================================
QUEUE_CONNECTION=redis
# ⚠️ CACHE_STORE, PAS CACHE_DRIVER — Laravel 11+ a renommé la clé.
# Mesuré le 2026-08-23 : avec `CACHE_DRIVER=redis`, `config('cache.default')`
# valait `database` (le défaut de `config/cache.php:17`). Redis arrêté, la sonde
# `/health` du cache restait `ok` : elle éprouvait la BASE. Un garde-fou vert
# avec la dépendance qu'il surveille à terre.
CACHE_STORE=redis
SESSION_DRIVER=redis

# ===========================================
# 💾 BACKUP STRATEGY (v1)
# ===========================================
# Couche 1 — backup local VPS quotidien : ACTIVÉ par défaut via scripts/ops/backup-local.sh
# (cf crontab.example pour activer le cron)
#
# Couche 2 — backup offsite (hands-off) : DÉSACTIVÉ par défaut.
# Pour activer (gratuit via Mega/Google Drive/pCloud free tier) :
#   1. Installer rclone : curl https://rclone.org/install.sh | sudo bash
#   2. Configurer : rclone config (créer un remote vers Mega/Drive)
#   3. Mettre BACKUP_OFFSITE_ENABLED=true ci-dessous
#   4. Décommenter la ligne crontab dans crontab.example
#
# Voir scripts/ops/backup-offsite.sh pour la doc complète et la migration
# vers Backblaze B2 payant (~0.50€/mois) en v2+ ou si projet validé.
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_REMOTE=
BACKUP_OFFSITE_PATH=myapp-backups/
BACKUP_OFFSITE_RETENTION_WEEKS=8

# ===========================================
# 📊 MONITORING - Watchtower Notifications
# ===========================================
# Laissez vide pour désactiver les notifications
WATCHTOWER_NOTIFICATION_URL=

# Exemples :
# Discord: discord://token@channel_id
# Slack: slack://hook_url
# Email: smtp://username:password@host:port/?from=from@example.com&to=to@example.com

# ===========================================
# 🛡️ SÉCURITÉ - SNYK CONFIGURATION
# ===========================================

# Token Snyk (optionnel - obtenez-le sur https://app.snyk.io/account)
# Si non configuré, Snyk fonctionnera en mode limité
SNYK_TOKEN=

# Configuration Snyk (avec valeurs par défaut optimales)
SNYK_SEVERITY_THRESHOLD=high
SNYK_FAIL_ON_ISSUES=false
SNYK_MONITOR_ENABLED=true
SNYK_ORG_ID=

# Fichiers à exclure du scan Snyk (patterns séparés par des virgules)
SNYK_EXCLUDE_PATHS=vendor/,node_modules/,tests/,storage/

# Options avancées Snyk
SNYK_INCLUDE_DEV_DEPS=true
SNYK_PRINT_DEPS=false
SNYK_DOCKER_SCAN_ENABLED=false

# Configuration pour différents environnements
SNYK_PROJECT_NAME_PHP="${APP_NAME}-php"
SNYK_PROJECT_NAME_NODE="${APP_NAME}-node"

# ===========================================
# 🔐 SÉCURITÉ
# ===========================================
JWT_SECRET=your-jwt-secret-key
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ===========================================
# 🔧 DÉVELOPPEMENT
# ===========================================
LOG_CHANNEL=stack
LOG_STACK=single,nightwatch,daily
LOG_LEVEL=debug
NIGHTWATCH_TOKEN="${NIGHTWATCH_TOKEN}"
NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0
NIGHTWATCH_COMMAND_SAMPLE_RATE=1.0
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1 #Recommended
TELESCOPE_ENABLED=true
HORIZON_DASHBOARD_ENABLED=true
VITE_APP_NAME="${APP_NAME}"